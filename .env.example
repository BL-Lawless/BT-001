# Required: Supabase project connection used by both headless loggers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Required: unique, explicit identity for this deployment. Do not reuse the laptop ID on the VM.
BT001_MACHINE_ID=replace-with-a-unique-deployment-id

# Required: Binance Futures symbol, uppercase with no separator.
BT001_SYMBOL=BTCUSDT

# Optional public Binance Futures endpoints.
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/market/stream

# Optional SSSC MA periods (exactly five positive integers).
SSSC_MA_PERIODS=9,21,55,100,200
