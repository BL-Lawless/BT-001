# Required: Supabase project connection used by both headless loggers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Required only by the VM liquidation heatmap oneshot. Never expose this in the browser app.
APIFY_API_KEY=your-apify-api-key

# Required: unique, explicit identity for this deployment. Do not reuse the laptop ID on the VM.
BT001_MACHINE_ID=replace-with-a-unique-deployment-id

# Required: Binance Futures symbol, uppercase with no separator.
BT001_SYMBOL=BTCUSDT

# Optional public Binance Futures endpoints.
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/market/stream

# Optional SSSC MA periods (exactly five positive integers).
SSSC_MA_PERIODS=9,21,55,100,200

# Optional independent heartbeat monitor settings.
# SSSC writes every ~30 seconds; alert after 3 minutes without a row.
MONITOR_SSSC_STALE_MS=180000
# Alert when this many consecutive calculated snapshot payloads are identical.
MONITOR_SSSC_FROZEN_ROWS=8
# Suppress another unresolved incident of the same type for six hours.
MONITOR_INCIDENT_DEDUPE_MS=21600000
# Set false when running outside the logger VM, where systemctl is unavailable.
MONITOR_CHECK_SYSTEMD=true
