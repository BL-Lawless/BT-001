# Dedicated MA Stack VM logger configuration. Copy to .env.ma-stack on the VM.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Required independent deployment identity. Do not reuse the SSSC machine ID.
MA_STACK_MACHINE_ID=replace-with-a-unique-ma-stack-deployment-id

MA_STACK_SYMBOL=BTCUSDT
MA_STACK_MA_PERIODS=9,21,55,100,200
MA_STACK_BINANCE_REST_URL=https://fapi.binance.com
MA_STACK_BINANCE_WS_URL=wss://fstream.binance.com/market/stream
MA_STACK_PROVISIONAL_INTERVAL_MS=30000

# Optional local durable spool for rows that exhaust Supabase retries.
MA_STACK_SPOOL_PATH=/home/nader_moustafa/BT-001/artifacts/ma-stack-supabase-spool.jsonl
